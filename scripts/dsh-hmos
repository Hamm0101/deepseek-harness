#!/bin/sh
# dsh-hmos — DeepSeek Harness on HarmonyOS 服务管理脚本
# 子命令: start | stop | status | restart | update | repatch | exec | help
# 用法示例:
#   dsh-hmos start                          # 默认 http://127.0.0.1:3080
#   dsh-hmos start --host 0.0.0.0 --port 8080
#   dsh-hmos stop [--port 8080]             # 不带 --port 停止全部
#   dsh-hmos update                         # npm 升级 + 重打补丁 + 重建 node-pty + 重启
#   dsh-hmos repatch                        # 只重打 4 处补丁(不重启)
#   dsh-hmos exec --help                    # 透传 dsh 命令
# 环境变量: HOMEBREW_PREFIX(默认 ~/.harmonybrew), DSH_PERMISSION_MODE(默认 danger-full-access)

HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-$HOME/.harmonybrew}"
DSH_DIR="$HOMEBREW_PREFIX/lib/node_modules/@deepseek-ai/dsh"
BIN="$DSH_DIR/lib/bin.js"
STATE_DIR="$HOME/.dsh-hmos"
NODE="$HOMEBREW_PREFIX/bin/node"
NPM="$HOMEBREW_PREFIX/bin/npm"
NODE_GYP="$HOMEBREW_PREFIX/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js"
CLANG="$HOMEBREW_PREFIX/bin/clang"
CLANGXX="$HOMEBREW_PREFIX/bin/clang++"
PATCH_MJS="$STATE_DIR/patch.mjs"
REGISTRY="https://registry.npmmirror.com"
DEFAULT_PORT=3080
DEFAULT_HOST="127.0.0.1"
PERMISSION_MODE="${DSH_PERMISSION_MODE:-danger-full-access}"

log() { echo "[dsh-hmos] $*"; }
die() { echo "[dsh-hmos] ERROR: $*" >&2; exit 1; }

# ---------- 参数解析: 第一个非 - 参数是子命令; --port/--host 消费下一个参数 ----------
CMD=""
PORT="$DEFAULT_PORT"
HOST="$DEFAULT_HOST"
prev=""
for a in "$@"; do
  if [ "$prev" = "--port" ]; then PORT="$a"; prev=""; continue; fi
  if [ "$prev" = "--host" ]; then HOST="$a"; prev=""; continue; fi
  case "$a" in
    --port|--host) prev="$a" ;;
    -*) ;;
    *) [ -z "$CMD" ] && CMD="$a" ;;
  esac
done

usage() {
  cat <<'EOF'
用法: dsh-hmos <子命令> [--port N] [--host H]

子命令:
  start      后台启动 dsh web (setsid 脱离进程组; PID/日志在 ~/.dsh-hmos/)
  stop       停止指定端口实例; 不带 --port 停止全部
  status     查看所有实例运行状态
  restart    停止后重新启动 (--port 指定同一端口)
  update     npm 升级 dsh → 重打 4 处补丁 → 重建 node-pty → 重装 sharp-wasm32 → 重启
  repatch    只重打 4 处补丁(幂等; 升级后必须跑)
  exec ...   透传 dsh 命令, 如: dsh-hmos exec --help
  help       本帮助
EOF
}

pidfile() { echo "$STATE_DIR/web-$1.pid"; }
logfile() { echo "$STATE_DIR/web-$1.log"; }

# 校验 PID 确属 dsh web 进程(/proc cmdline 防误杀)
is_dsh_pid() {
  [ -n "$1" ] || return 1
  case "$1" in *[!0-9]*) return 1 ;; esac
  tr '\0' ' ' 2>/dev/null < "/proc/$1/cmdline" | grep -q "bin.js" || return 1
  return 0
}

port_up() { # $1=host $2=port
  "$NODE" -e "fetch('http://$1:$2').then(()=>process.exit(0)).catch(()=>process.exit(1))" >/dev/null 2>&1
}

# ---------- status ----------
status_cmd() {
  found=0
  for f in "$STATE_DIR"/web-*.pid; do
    [ -f "$f" ] || continue
    found=1
    p="${f##*web-}"; p="${p%.pid}"
    pid=$(cat "$f" 2>/dev/null)
    if is_dsh_pid "$pid" && port_up "$HOST" "$p"; then
      echo "port $p: 运行中 (pid $pid)"
    else
      echo "port $p: 未运行 (残留 PID 文件已清理)"
      rm -f "$f"
    fi
  done
  if [ "$found" -eq 0 ]; then
    if port_up "$HOST" "$PORT"; then
      echo "port $PORT: 运行中 (无 PID 文件, 由外部启动)"
    else
      echo "port $PORT: 未运行"
    fi
  fi
}

# ---------- stop ----------
stop_one() { # $1=port
  f=$(pidfile "$1")
  if [ ! -f "$f" ]; then
    log "port $1: 无 PID 文件, 跳过"
    return 0
  fi
  pid=$(cat "$f" 2>/dev/null)
  if ! is_dsh_pid "$pid"; then
    log "port $1: PID 文件过期($pid), 清理"
    rm -f "$f"
    return 0
  fi
  kill "$pid" 2>/dev/null
  i=0
  while [ $i -lt 10 ] && is_dsh_pid "$pid"; do sleep 1; i=$((i+1)); done
  if is_dsh_pid "$pid"; then kill -9 "$pid" 2>/dev/null; fi
  rm -f "$f"
  log "port $1: 已停止 (pid $pid)"
}

stop_cmd() {
  stopped=0
  for f in "$STATE_DIR"/web-*.pid; do
    [ -f "$f" ] || continue
    p="${f##*web-}"; p="${p%.pid}"
    stop_one "$p"
    stopped=1
  done
  if [ "$stopped" -eq 0 ]; then log "没有运行中的实例"; fi
}

# ---------- start ----------
start_cmd() {
  if port_up "$HOST" "$PORT"; then
    log "已在运行: http://$HOST:$PORT"
    return 0
  fi
  [ -f "$BIN" ] || die "未找到 dsh: $BIN (先执行 npm install -g @deepseek-ai/dsh)"
  mkdir -p "$STATE_DIR"
  log "启动 dsh web → http://$HOST:$PORT (日志: $(logfile "$PORT"))"
  DSH_PERMISSION_MODE="$PERMISSION_MODE" \
    setsid "$NODE" --expose-internals "$BIN" web --host "$HOST" --port "$PORT" \
      >> "$(logfile "$PORT")" 2>&1 < /dev/null &
  echo $! > "$(pidfile "$PORT")"
  i=0
  while [ $i -lt 20 ]; do
    if port_up "$HOST" "$PORT"; then
      log "启动成功: http://$HOST:$PORT"
      return 0
    fi
    sleep 1; i=$((i+1))
  done
  log "探活超时, 请查看日志: $(logfile "$PORT")"
  return 1
}

restart_cmd() { stop_cmd; start_cmd; }

# ---------- repatch ----------
repatch_cmd() {
  [ -f "$PATCH_MJS" ] || die "缺少 $PATCH_MJS"
  [ -d "$DSH_DIR" ] || die "未安装 dsh: $DSH_DIR"
  "$NODE" "$PATCH_MJS" --dsh-dir "$DSH_DIR"
}

# ---------- update ----------
update_cmd() {
  log "1/6 停止当前实例..."
  stop_cmd
  log "2/6 npm 升级 @deepseek-ai/dsh (--ignore-scripts)..."
  "$NPM" install -g @deepseek-ai/dsh --ignore-scripts --registry="$REGISTRY" || die "npm install 失败"
  log "3/6 重打全部补丁 (P1-P9)..."
  repatch_cmd || die "补丁重放失败, 请人工检查"
  log "4/6 重建 node-pty 并重装 sharp-wasm32..."
  ( cd "$DSH_DIR/node_modules/node-pty" \
      && CC="$CLANG" CXX="$CLANGXX" "$NODE" "$NODE_GYP" rebuild ) || die "node-pty 构建失败"
  ( cd "$DSH_DIR" \
      && "$NPM" install @img/sharp-wasm32 --ignore-scripts --registry="$REGISTRY" --no-save ) || die "sharp-wasm32 安装失败"
  log "5/6 重建 koffi native (subprocess-local 依赖)..."
  command -v cmake >/dev/null 2>&1 || die "缺少 cmake: 请先 brew install cmake"
  # cnoke 构建会复用 build/ 缓存; 升级后 koffi 是全新安装, 但缓存过期的
  # x64 配置会让架构推导失效, 所以先清空再构建 (arm64 平台必需)。
  rm -rf "$DSH_DIR/node_modules/koffi/build"
  ( cd "$DSH_DIR/node_modules/koffi" \
      && CC="$CLANG" CXX="$CLANGXX" "$NODE" ./cnoke.cjs build -P . -D src/koffi --release ) || die "koffi 构建失败"
  log "6/6 重启服务..."
  start_cmd
}

exec_cmd() {
  [ -f "$BIN" ] || die "未找到 dsh: $BIN"
  shift
  "$NODE" --expose-internals "$BIN" "$@"
}

case "$CMD" in
  start) start_cmd ;;
  stop) stop_cmd ;;
  status) status_cmd ;;
  restart) restart_cmd ;;
  update) update_cmd ;;
  repatch) repatch_cmd ;;
  exec) exec_cmd "$@" ;;
  help|-h|--help|"") usage ;;
  *) usage; die "未知子命令: $CMD" ;;
esac
